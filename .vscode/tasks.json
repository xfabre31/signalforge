{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Setup: Python",
      "type": "shell",
      "command": "python3.12 -m venv .venv && .venv/bin/python -m pip install -r backend/requirements.txt",
      "problemMatcher": []
    },
    {
      "label": "Setup: Frontend",
      "type": "shell",
      "command": "npm install",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "problemMatcher": []
    },
    {
      "label": "Setup: Full project",
      "dependsOn": ["Setup: Python", "Setup: Frontend"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    },
    {
      "label": "Dev: API",
      "type": "shell",
      "command": ".venv/bin/uvicorn app.main:app --reload --app-dir backend",
      "isBackground": true,
      "problemMatcher": {
        "owner": "signalforge",
        "pattern": { "regexp": "^(.*)$", "message": 1 },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*Uvicorn running.*",
          "endsPattern": ".*Application startup complete.*"
        }
      },
      "presentation": { "panel": "dedicated", "group": "dev" }
    },
    {
      "label": "Dev: Dashboard",
      "type": "npm",
      "script": "dev",
      "path": "frontend",
      "isBackground": true,
      "problemMatcher": {
        "owner": "signalforge",
        "pattern": { "regexp": "^(.*)$", "message": 1 },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*VITE.*",
          "endsPattern": ".*Local:.*"
        }
      },
      "presentation": { "panel": "dedicated", "group": "dev" }
    },
    {
      "label": "Dev: SignalForge",
      "dependsOn": ["Dev: API", "Dev: Dashboard"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    },
    {
      "label": "Test: Backend",
      "type": "shell",
      "command": ".venv/bin/python -m pytest backend/tests",
      "problemMatcher": []
    }
  ]
}

